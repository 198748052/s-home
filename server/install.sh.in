#!/bin/sh
# 天气 App 云端配置服务：一键安装 / 升级（自带二进制，服务器上不用装 Go）
#
# 用法（root 运行）：
#   sudo sh install-amd64.sh                 # 默认装到 /root/data/tianqi，端口 8787
#   sudo sh install-amd64.sh --port 9000     # 换端口
#   sudo sh install-amd64.sh --dir /root/data/tianqi   # 换目录
#
# 装完只要用浏览器打开 http://服务器IP:端口/admin：
#   第一次进去设置管理员口令，然后在网页里填 Key、改端口、改域名、复制 App 令牌。
# 反代自己做，服务只监听一个端口。
# 可重复执行：升级只替换二进制并重启，配置与口令保持不动。
set -e

ARCH="__ARCH__"
PAYLOAD_SHA256="__SHA256__"
SERVICE="tianqi-config"
DIR="/root/data/tianqi"
PORT="8787"

while [ $# -gt 0 ]; do
    case "$1" in
        --dir)  DIR="$2"; shift 2 ;;
        --port) PORT="$2"; shift 2 ;;
        -h|--help)
            sed -n '2,12p' "$0" | sed 's/^# \{0,1\}//'
            exit 0 ;;
        *)
            echo "未知参数：$1（用 --help 看用法）" >&2
            exit 2 ;;
    esac
done

[ "$(id -u)" = "0" ] || { echo "请用 root 运行：sudo sh $0" >&2; exit 1; }

MACHINE="$(uname -m)"
case "$MACHINE" in
    x86_64|amd64)  CURRENT="amd64" ;;
    aarch64|arm64) CURRENT="arm64" ;;
    *) echo "不支持的架构：$MACHINE" >&2; exit 1 ;;
esac
if [ "$CURRENT" != "$ARCH" ]; then
    echo "这个脚本是给 $ARCH 用的，但服务器是 $MACHINE，请换 install-$CURRENT.sh" >&2
    exit 1
fi

for cmd in awk tail base64; do
    command -v "$cmd" >/dev/null 2>&1 || { echo "缺少命令：$cmd" >&2; exit 1; }
done

# ---------- 1. 解出二进制 ----------
echo "==> 解出二进制"
mkdir -p "$DIR"
TMPBIN="$(mktemp)"
START="$(awk '/^__PAYLOAD_BELOW__$/{print NR+1; exit}' "$0")"
if [ -z "$START" ]; then
    echo "脚本里没有找到二进制数据（文件可能被截断）" >&2
    exit 1
fi
tail -n +"$START" "$0" | base64 -d > "$TMPBIN"

if command -v sha256sum >/dev/null 2>&1; then
    GOT="$(sha256sum "$TMPBIN" | awk '{print $1}')"
    if [ "$GOT" != "$PAYLOAD_SHA256" ]; then
        echo "二进制校验失败（期望 $PAYLOAD_SHA256，实际 $GOT）" >&2
        rm -f "$TMPBIN"
        exit 1
    fi
    echo "    校验通过"
fi
install -m 0755 "$TMPBIN" "$DIR/tianqi-config"
rm -f "$TMPBIN"

# ---------- 2. 首次安装写默认配置 ----------
echo "==> 准备目录与配置"
if [ -f "$DIR/config.json" ]; then
    echo "    已有 config.json，保持不动（缺的字段由服务按内置默认值自动补齐）"
else
    echo "    config.json 由服务首次启动时生成（默认：聚合万年历 + 和风天气 + MiMo）"
fi
chmod 700 "$DIR"
# config.json 由服务首次启动时生成，这里只在它已经存在时收紧权限
if [ -f "$DIR/config.json" ]; then chmod 640 "$DIR/config.json"; fi
echo "    目录：$DIR"

# ---------- 3. systemd ----------
echo "==> 安装 systemd 服务"
cat > "/etc/systemd/system/$SERVICE.service" <<UNIT
[Unit]
Description=Tianqi cloud config service
After=network.target

[Service]
Type=simple
WorkingDirectory=$DIR
ExecStart=$DIR/tianqi-config -config $DIR/config.json -data $DIR -port $PORT
Restart=always
RestartSec=3
User=root
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
# 数据在 /root 下，不能开 ProtectHome
ProtectHome=false
ReadWritePaths=$DIR

[Install]
WantedBy=multi-user.target
UNIT

systemctl daemon-reload
systemctl enable "$SERVICE" >/dev/null 2>&1 || true
systemctl restart "$SERVICE"
sleep 1

if ! systemctl is-active --quiet "$SERVICE"; then
    echo "服务没起来，最近日志：" >&2
    journalctl -u "$SERVICE" -n 20 --no-pager >&2 || true
    exit 1
fi

# ---------- 4. 自检 ----------
echo "==> 自检"
ACTUAL_PORT="$PORT"
if [ -f "$DIR/server.json" ] && command -v grep >/dev/null 2>&1; then
    SAVED="$(grep -o '"port"[^,}]*' "$DIR/server.json" | head -1 | tr -dc '0-9')"
    if [ -n "$SAVED" ]; then ACTUAL_PORT="$SAVED"; fi
fi
if command -v curl >/dev/null 2>&1; then
    CODE="$(curl -s -o /dev/null -w '%{http_code}' "http://127.0.0.1:$ACTUAL_PORT/admin" || true)"
    case "$CODE" in
        200) echo "    管理页可访问（端口 $ACTUAL_PORT）" ;;
        401) echo "    服务已启动，但接口要鉴权（HTTP 401），请看日志" ;;
        *)   echo "    管理页返回 $CODE，请检查 journalctl -u $SERVICE -n 30" >&2 ;;
    esac
fi

# ---------- 5. 汇总 ----------
LAN_IP="$(hostname -I 2>/dev/null | awk '{print $1}')"
PUBLIC_IP=""
if command -v curl >/dev/null 2>&1; then
    for url in https://myip.ipip.net https://api.ipify.org https://ifconfig.me; do
        PUBLIC_IP="$(curl -s --max-time 3 "$url" 2>/dev/null | grep -Eo '([0-9]{1,3}\.){3}[0-9]{1,3}' | head -1)"
        if [ -n "$PUBLIC_IP" ]; then break; fi
    done
fi
if [ -z "$LAN_IP" ]; then LAN_IP="<内网IP>"; fi

echo
echo "================= 安装完成 ================="
echo "服务：systemctl status $SERVICE"
echo "日志：journalctl -u $SERVICE -f"
echo "目录：$DIR"
echo
echo "浏览器打开（第一次进去设置管理员口令）："
if [ -n "$PUBLIC_IP" ]; then
    echo "  http://$PUBLIC_IP:$ACTUAL_PORT/admin      ← 从你自己电脑访问用这个（公网 IP）"
else
    echo "  http://<服务器公网IP>:$ACTUAL_PORT/admin  ← 公网 IP 在云控制台看"
fi
echo "  http://$LAN_IP:$ACTUAL_PORT/admin        ← 内网 IP，只有同一内网/VPN 才能用"
echo
echo "打不开的话按顺序检查："
echo "  1) 云厂商控制台 → 安全组 → 入方向放行 TCP $ACTUAL_PORT"
echo "  2) 宝塔面板 → 安全 → 放行端口 $ACTUAL_PORT（装了宝塔的话）"
echo "  3) 系统防火墙：firewall-cmd --add-port=$ACTUAL_PORT/tcp（或 ufw allow $ACTUAL_PORT）"
echo
echo "不想现在开端口？用 SSH 隧道临时访问（在你本机执行）："
echo "  ssh -L $ACTUAL_PORT:127.0.0.1:$ACTUAL_PORT root@<服务器公网IP>"
echo "  然后本机浏览器打开 http://127.0.0.1:$ACTUAL_PORT/admin"
echo
echo "进去之后可以在网页里："
echo "  · 填和风天气 / 聚合数据 / 语音合成的 Key"
echo "  · 换语音厂商（MiMo / OpenAI 兼容 / 自定义接口）"
echo "  · 改端口、填对外域名、改管理员口令"
echo "  · 复制 App 访问令牌（填进 App 的 CONFIG_TOKEN）"
echo "  · 点「测试语音合成」确认 Key 通不通"
echo
echo "反代自己做即可，服务只监听 0.0.0.0:$ACTUAL_PORT。"
echo "============================================"
exit 0

__PAYLOAD_BELOW__
